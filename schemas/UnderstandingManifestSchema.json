{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "code",
        "url-only"
      ]
    },
    "authoredBy": {
      "type": "string",
      "maxLength": 100
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "binding": {
      "type": "object",
      "properties": {
        "configSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "configSha256"
      ],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "purpose": {
          "type": "string",
          "maxLength": 1500
        },
        "audience": {
          "type": "string",
          "maxLength": 500
        },
        "primaryOutcome": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "name",
        "purpose",
        "audience",
        "primaryOutcome"
      ],
      "additionalProperties": false
    },
    "safeStart": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "managed",
            "existing"
          ]
        },
        "command": {
          "type": "string",
          "maxLength": 1000
        },
        "args": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "cwd": {
          "type": "string",
          "maxLength": 1000
        },
        "explanation": {
          "type": "string",
          "maxLength": 1500
        },
        "evidenceIds": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          }
        }
      },
      "required": [
        "mode",
        "explanation",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "flow": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "summary": {
            "type": "string",
            "maxLength": 1200
          },
          "actionIndexes": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "evidenceIds": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            }
          },
          "success": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 1200
              },
              "locator": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "role"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "testid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "testid"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "css": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "css"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "description",
              "locator"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "summary",
          "actionIndexes",
          "evidenceIds",
          "success"
        ],
        "additionalProperties": false
      }
    },
    "sourceEvidence": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "startLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "endLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "fileSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "excerptSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "startLine",
          "endLine",
          "fileSha256",
          "excerptSha256"
        ],
        "additionalProperties": false
      }
    },
    "uiEvidence": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "locator": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "role"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "label"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "testid": {
                    "type": "string"
                  }
                },
                "required": [
                  "testid"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "css": {
                    "type": "string"
                  }
                },
                "required": [
                  "css"
                ],
                "additionalProperties": false
              }
            ]
          },
          "observation": {
            "type": "string",
            "maxLength": 1500
          },
          "artifact": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "url",
          "observedAt",
          "locator",
          "observation",
          "artifact"
        ],
        "additionalProperties": false
      }
    },
    "codeUnavailableReason": {
      "type": "string",
      "maxLength": 1500
    },
    "limitations": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "mode",
    "authoredBy",
    "reviewedAt",
    "binding",
    "product",
    "safeStart",
    "flow",
    "sourceEvidence",
    "uiEvidence",
    "limitations"
  ],
  "additionalProperties": false
}
