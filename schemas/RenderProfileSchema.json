{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 7680
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 7680
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    }
  },
  "required": [
    "name",
    "width",
    "height",
    "fps"
  ],
  "additionalProperties": false
}
