{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "durationSec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "checks": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "enum": [
              "content",
              "framing",
              "motion",
              "audio"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-tested"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "not-performed",
              "frames-and-source",
              "normal-speed-playback",
              "listening"
            ]
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSec": {
                  "type": "number",
                  "minimum": 0
                },
                "endSec": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "startSec",
                "endSec"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion",
          "status",
          "method",
          "coverage",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atSec": {
            "type": "number",
            "minimum": 0
          },
          "criterion": {
            "type": "string",
            "enum": [
              "content",
              "framing",
              "motion",
              "audio"
            ]
          },
          "symptom": {
            "type": "string",
            "minLength": 1
          },
          "correction": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "atSec",
          "criterion",
          "symptom",
          "correction",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "artifactSha256",
    "durationSec",
    "reviewer",
    "reviewedAt",
    "checks",
    "defects"
  ],
  "additionalProperties": false
}
