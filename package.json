{
  "name": "product-demo-toolkit",
  "version": "0.4.0",
  "description": "Переносимый Skill: разбор кода, запись сайта, русская озвучка и монтаж Remotion",
  "type": "module",
  "private": true,
  "bin": {
    "demo-video": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/schema.js"
  },
  "files": [
    "dist",
    "src/render",
    "examples",
    "skills",
    "scripts",
    "docs",
    "schemas",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "package-lock.json",
    "CODEX.md",
    "CLAUDE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "remotion": "4.0.527",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "playwright": "1.63.0",
    "zod": "4.6.5",
    "commander": "15.0.0",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maksimpotap877-sketch/product-demo-skill.git"
  }
}
